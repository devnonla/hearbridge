{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HearBridge",
  "version": "../package.json",
  "identifier": "com.quypv.hearbridge",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HearBridge",
        "width": 960,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "category": "Productivity",
    "copyright": "Copyright © 2026 Quy Pham Van. MIT License."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MUY4NTI3QjhDNjU2QkMKUldTOFZzYTRKNFVmdDJxcVpGUGRMU3krYzBCd29xTm1aL3JBN1dmS0tPQnViNE9DRDhPMUNDc3oK",
      "endpoints": [
        "https://github.com/devnonla/hearbridge/releases/latest/download/latest.json"
      ]
    }
  }
}
